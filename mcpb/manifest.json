{
  "manifest_version": "0.3",
  "name": "c3d-mcp",
  "display_name": "Cheetah3D",
  "version": "0.2.1",
  "description": "Inspect, build, animate, light, material, render and export scenes in Cheetah3D 8.1.3.",
  "long_description": "Controls the running Cheetah3D 8.1.3 on macOS through a file-mailbox bridge macro and an Accessibility helper. Run the bundled `c3d_install_bridge` tool once, then restart Cheetah3D.",
  "author": { "name": "megatih" },
  "license": "MIT",
  "keywords": ["cheetah3d", "3d", "rendering", "macos"],
  "server": {
    "type": "node",
    "entry_point": "server/bin/c3d-mcp.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/bin/c3d-mcp.js", "serve"],
      "env": {
        "C3D_MCP_PROFILE": "${user_config.profile}",
        "C3D_MCP_DISABLE_EXEC": "${user_config.disable_exec}",
        "C3D_MCP_DISABLE_ASSETS": "${user_config.disable_assets}"
      }
    }
  },
  "tools_generated": true,
  "compatibility": { "platforms": ["darwin"], "runtimes": { "node": ">=22.0.0" } },
  "user_config": {
    "profile": { "type": "string", "title": "Tool profile", "description": "full (all tools), local (small set for local models) or readonly.", "default": "full", "required": false },
    "disable_exec": { "type": "boolean", "title": "Disable script execution", "description": "Hide c3d_run_script.", "default": false, "required": false },
    "disable_assets": { "type": "boolean", "title": "Disable asset downloads", "description": "Hide Poly Haven search/import tools.", "default": false, "required": false }
  }
}
