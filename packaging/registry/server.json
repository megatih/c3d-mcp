{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.megatih/c3d-mcp",
  "description": "MCP server for Cheetah3D 8.1.3 on macOS: inspect, build, animate, light, material and render scenes.",
  "repository": {
    "url": "https://github.com/megatih/c3d-mcp",
    "source": "github"
  },
  "version": "0.1.4",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "c3d-mcp",
      "version": "0.1.4",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ],
      "environmentVariables": [
        {
          "name": "C3D_MCP_PROFILE",
          "description": "full | local | readonly",
          "isRequired": false,
          "default": "full"
        }
      ]
    },
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/megatih/c3d-mcp/releases/download/v0.1.4/c3d-mcp-0.1.4.mcpb",
      "version": "0.1.4",
      "fileSha256": "f1280a039b33e4cf96a6f6f6499982e753ad40d5090321aba6c901243cb200f5",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
