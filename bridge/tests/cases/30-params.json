  {
   "name": "param serialization helpers (JS-side): unsupported types, vec shapes, unreadable values",
   "presses": [
    {
     "expect": {
      "js": [
       {
        "eval": "C3D.params.readParam({ getParameter: function () { return {}; } }, 'g', 'Gradient')",
        "equals": {
         "name": "g",
         "type": "Gradient",
         "value": {
          "unsupported": true
         }
        }
       },
       {
        "eval": "C3D.params.readParam({ getParameter: function () { return {}; } }, 'g', 'FloatArray').value",
        "equals": {
         "unsupported": true
        }
       },
       {
        "eval": "C3D.params.readParam({ getParameter: function () { throw new Error('x'); } }, 'p', 'Float')",
        "equals": {
         "name": "p",
         "type": "Float",
         "value": null,
         "unreadable": true
        }
       },
       {
        "eval": "(function () { try { C3D.params.toNative({}, 'Gradient', 1, 'g'); } catch (e) { return e.code; } })()",
        "equals": "UNSUPPORTED"
       },
       {
        "eval": "(function () { try { C3D.params.toNative({}, 'FloatArray', [1], 'g'); } catch (e) { return e.code; } })()",
        "equals": "UNSUPPORTED"
       },
       {
        "eval": "C3D.params.readParam({ getParameter: function () { return new Vec2D(1, 2); } }, 'v', 'Vec2D').value",
        "equals": {
         "x": 1,
         "y": 2
        }
       },
       {
        "eval": "C3D.params.readParam({ getParameter: function () { return new Vec4D(1, 2, 3, 4); } }, 'v', 'Vec4D').value",
        "equals": {
         "x": 1,
         "y": 2,
         "z": 3,
         "w": 4
        }
       },
       {
        "eval": "C3D.params.readParam({ getParameter: function () { return undefined; } }, 't', 'Texture').value",
        "equals": ""
       },
       {
        "eval": "C3D.params.readParam({ getParameter: function () { return undefined; } }, 'l', 'Link').value",
        "equals": null
       },
       {
        "eval": "C3D.params.readParam({ getParameter: function () { return 1; } }, 'b', 'Bool').value",
        "equals": true
       },
       {
        "eval": "JSON.stringify([C3D.params.numbers([1, 2, 3, 4], 4, 'c'), C3D.params.numbers({ r: 1, g: 2, b: 3 }, 4, 'c'), C3D.params.numbers({ x: 1, y: 2 }, 2, 'c'), C3D.params.numbers([1, 2, 3], 4, 'c')])",
        "equals": "[[1,2,3,4],[1,2,3,1],[1,2],[1,2,3,1]]"
       },
       {
        "eval": "String(C3D.params.makeVec(3, [1, 2, 3]))",
        "equals": "[object CallbackObject]"
       },
       {
        "eval": "C3D.params.typeMap({ parameterInfo: function () { return [['resolution', 'unknown'], ['x', 'Int']]; } }).types.resolution",
        "equals": "Vec2D"
       },
       {
        "eval": "C3D.util.asciiEscape('\\u540d\\u7f6e\\u007f')",
        "equals": "\\u540d\\u7f6e\\u007f"
       },
       {
        "eval": "C3D.util.adler32('Wikipedia')",
        "equals": "11e60398"
       },
       {
        "eval": "JSON.stringify(C3D.util.splitPath('/A/b\\\\/c/\\\\\\\\d'))",
        "equals": "[\"A\",\"b/c\",\"\\\\d\"]"
       },
       {
        "eval": "C3D.util.escapeName('a/b\\\\c')",
        "equals": "a\\/b\\\\c"
       }
      ]
     }
    }
   ]
