  {
   "name": "expectDocument.marker (untitled documents)",
   "presses": [
    {
     "requests": [
      {
       "label": "m",
       "ops": [
        {
         "op": "setMarker",
         "args": {
          "uuid": "11111111-2222-3333-4444-555555555555"
         }
        },
        {
         "op": "setMarker",
         "args": {
          "uuid": "11111111-2222-3333-4444-555555555555"
         }
        },
        {
         "op": "getDocumentInfo"
        }
       ]
      }
     ],
     "expect": {
      "responses": {
       "m": {
        "ok": true,
        "protocol": 1,
        "results": [
         {
          "op": "setMarker",
          "ok": true,
          "result": {
           "marker": "__c3d_mcp_session_11111111-2222-3333-4444-555555555555",
           "created": true
          }
         },
         {
          "op": "setMarker",
          "ok": true,
          "result": {
           "marker": "__c3d_mcp_session_11111111-2222-3333-4444-555555555555",
           "created": false
          }
         },
         {
          "op": "getDocumentInfo",
          "ok": true,
          "result": {
           "marker": "__c3d_mcp_session_11111111-2222-3333-4444-555555555555",
           "fileName": null,
           "objectCount": 1
          }
         }
        ]
       }
      }
     }
    },
    {
     "requests": [
      {
       "label": "ok",
       "ops": [
        {
         "op": "ping"
        }
       ],
       "expectDocument": {
        "marker": "__c3d_mcp_session_11111111-2222-3333-4444-555555555555"
       }
      },
      {
       "label": "wrong",
       "ops": [
        {
         "op": "ping"
        }
       ],
       "expectDocument": {
        "marker": "__c3d_mcp_session_99999999-2222-3333-4444-555555555555"
       }
      },
      {
       "label": "both",
       "ops": [
        {
         "op": "ping"
        }
       ],
       "expectDocument": {
        "marker": "__c3d_mcp_session_11111111-2222-3333-4444-555555555555",
        "fileName": "x.jas"
       }
      }
     ],
     "expect": {
      "responses": {
       "ok": {
        "ok": true,
        "protocol": 1,
        "results": [
         {
          "op": "ping",
          "ok": true
         }
        ]
       },
       "wrong": {
        "ok": false,
        "error": {
         "code": "WRONG_DOCUMENT"
        }
       },
       "both": {
        "ok": false,
        "error": {
         "code": "WRONG_DOCUMENT"
        }
       }
      }
     }
    }
   ]
