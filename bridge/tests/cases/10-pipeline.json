{
 "cases": [
  {
   "name": "ping roundtrip",
   "presses": [
    {
     "requests": [
      {
       "label": "a",
       "ops": [
        {
         "op": "ping",
         "args": {
          "counter": 7,
          "echo": "hi"
         }
        }
       ]
      }
     ],
     "expect": {
      "responses": {
       "a": {
        "ok": true,
        "protocol": 1,
        "results": [
         {
          "op": "ping",
          "ok": true,
          "result": {
           "counter": 7,
           "echo": "hi",
           "runtimeVersion": "1.0.1",
           "jsc": true,
           "stateBusy": false,
           "now": {
            "$type": "number"
           }
          }
         }
        ],
        "runtimeVersion": "1.0.1",
        "startedAt": {
         "$type": "number"
        },
        "finishedAt": {
         "$type": "number"
        }
       }
      },
      "state": {
       "busy": false,
       "protocol": 1,
       "runtimeVersion": "1.0.1",
       "lastSeq": "1800000000000100",
       "document": null
      }
     }
    }
   ]
  },
  {
   "name": "idempotency: pressing twice executes exactly once",
   "presses": [
    {
     "requests": [
      {
       "label": "a",
       "ops": [
        {
         "op": "createObject",
         "args": {
          "type": "BOX",
          "name": "Once"
         }
        },
        {
         "op": "ping",
         "args": {
          "counter": 1
         }
        }
       ]
      }
     ],
     "expect": {
      "responses": {
       "a": {
        "ok": true,
        "protocol": 1,
        "results": [
         {
          "op": "createObject",
          "ok": true,
          "result": {
           "name": "Once"
          }
         },
         {
          "op": "ping",
          "ok": true,
          "result": {
           "counter": 1
          }
         }
        ]
       }
      },
      "js": [
       {
        "eval": "doc.root().childCount()",
        "equals": 1
       }
      ]
     }
    },
    {
     "expect": {
      "js": [
       {
        "eval": "doc.root().childCount()",
        "equals": 1
       },
       {
        "eval": "__stats.retain",
        "equals": 0
       }
      ],
      "state": {
       "lastSeq": "1800000000000100"
      },
      "noFiles": [
       "outbox/_bootstrap-error.json"
      ]
     }
    },
    {
     "expect": {
      "js": [
       {
        "eval": "doc.root().childCount()",
        "equals": 1
       }
      ],
      "responses": {
       "a": {
        "ok": true,
        "protocol": 1,
        "results": [
         {
          "op": "createObject",
          "ok": true
         },
         {
          "op": "ping",
          "ok": true
         }
        ]
       }
      }
     }
    }
   ]
  },
  {
   "name": "stale seq (<= state.lastSeq) is skipped silently, newer one runs",
   "presses": [
    {
     "requests": [
      {
       "label": "old",
       "ops": [
        {
         "op": "createObject",
         "args": {
          "type": "BOX"
         }
        }
       ],
       "seq": "1800000000000100"
      },
      {
       "label": "new",
       "ops": [
        {
         "op": "ping"
        }
       ],
       "seq": "1800000000001000"
      }
     ],
     "expect": {
      "noResponse": [
       "old"
      ],
      "responses": {
       "new": {
        "ok": true,
        "protocol": 1,
        "results": [
         {
          "op": "ping",
          "ok": true
         }
        ]
       }
      },
      "js": [
       {
        "eval": "doc.root().childCount()",
        "equals": 0
       }
      ],
      "state": {
       "lastSeq": "1800000000001000"
      }
     }
    }
   ],
   "setup": {
    "state": {
     "busy": false,
     "runtimeVersion": "1.0.1",
     "lastSeq": "1800000000000900"
    }
   }
  },
  {
   "name": "request whose .done marker already exists is not re-executed",
   "presses": [
    {
     "requests": [
      {
       "label": "done",
       "ops": [
        {
         "op": "createObject",
         "args": {
          "type": "BOX"
         }
        }
       ],
       "preDone": true
      }
     ],
     "expect": {
      "noResponse": [
       "done"
      ],
      "js": [
       {
        "eval": "doc.root().childCount()",
        "equals": 0
       }
      ]
     }
    }
   ]
  },
  {
   "name": "expired deadline gives TIMEOUT and runs no op",
   "presses": [
    {
     "requests": [
      {
       "label": "t",
       "ops": [
        {
         "op": "createObject",
         "args": {
          "type": "BOX"
         }
        }
