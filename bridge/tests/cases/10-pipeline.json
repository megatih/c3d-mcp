         "code": "TIMEOUT"
        }
       }
      },
      "js": [
       {
        "eval": "doc.root().childCount()",
        "equals": 0
       },
       {
        "eval": "__stats.retain",
        "equals": 0
       }
      ]
     }
    },
    {
     "requests": [
      {
       "label": "late",
       "ops": [
        {
         "op": "ping"
        }
       ],
       "seq": "1800000000000050"
      }
     ],
     "expect": {
      "noResponse": [
       "late"
      ]
     }
    }
   ]
  },
