  {
   "name": "ASCII roundtrip: non-ASCII names via request and response, escaped path",
   "presses": [
    {
     "requests": [
      {
       "label": "n",
       "ops": [
        {
         "op": "createObject",
         "args": {
          "type": "BOX",
          "name": "\u540d\u524d"
         },
         "as": "a"
        },
        {
         "op": "createObject",
         "args": {
          "type": "BOX",
          "name": "a/b"
         }
        },
        {
         "op": "getObject",
         "args": {
          "ref": {
           "path": "/\u540d\u524d"
          }
         }
        },
        {
         "op": "getObject",
         "args": {
          "ref": {
           "path": "/a\\/b"
          }
         }
        },
        {
         "op": "run",
         "args": {
          "code": "print('\u540d\u524d'); return '\u00e9';"
         }
        }
       ]
      }
     ],
     "expect": {
      "responses": {
       "n": {
        "ok": true,
        "protocol": 1,
        "results": [
         {
          "op": "createObject",
          "ok": true,
          "result": {
           "name": "\u540d\u524d",
           "path": "/\u540d\u524d"
          }
         },
         {
          "op": "createObject",
          "ok": true,
          "result": {
           "path": "/a\\/b"
          }
         },
         {
          "op": "getObject",
          "ok": true,
          "result": {
           "name": "\u540d\u524d"
          }
         },
         {
          "op": "getObject",
          "ok": true,
          "result": {
           "name": "a/b"
          }
         },
         {
          "op": "run",
          "ok": true,
          "result": {
           "value": "\u00e9",
           "log": [
            "\u540d\u524d"
           ]
          }
         }
        ]
       }
      },
      "js": [
       {
        "eval": "doc.root().childAtIndex(0).getParameter('name').charCodeAt(0)",
        "equals": 21517
       }
      ],
      "files": {
       "outbox/_log.json": {
        "lines": {
         "$has": {
          "$re": "print: "
         }
        }
       }
      }
     }
    }
   ]
  },
  {
   "name": "mock fidelity: File.write truncates non-ASCII output (P05)",
   "presses": [
    {
     "expect": {
      "js": [
       {
        "eval": "(function () { var f = new File('{MCP}/tmp/q.txt'); f.open(WRITE_MODE); f.write('\\u540d\\u524d'); f.close(); return new File('{MCP}/tmp/q.txt').size(); })()",
        "equals": 2
       },
       {
        "eval": "(function () { var f = new File('{MCP}/tmp/q.txt'); f.open(WRITE_MODE); f.write('ab'); f.write('cd'); f.close(); f.open(READ_MODE); return f.read(f.size()); })()",
        "equals": "abcd"
       },
       {
        "eval": "(function () { var f = new File('{MCP}/tmp/q.txt'); f.open(WRITE_MODE); f.write('x'); f.close(); return new File('{MCP}/tmp/q.txt').size(); })()",
        "equals": 1
       },
       {
        "eval": "new File('{MCP}/inbox').contentOfDir().length",
        "equals": 0
       },
       {
        "eval": "(function () { new File('{MCP}/tmp/.dot').open(WRITE_MODE); new File('{MCP}/tmp/b.json.tmp').open(WRITE_MODE); return new File('{MCP}/tmp').contentOfDir(); })()",
        "equals": [
         ".dot",
         "b.json.tmp",
         "q.txt"
        ]
       },
       {
        "eval": "String(new Vec3D(1, 2, 3))",
        "equals": "[object CallbackObject]"
