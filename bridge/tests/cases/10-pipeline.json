  {
   "name": "batch refs: as / $alias / $alias.field",
   "presses": [
    {
     "requests": [
      {
       "label": "b",
       "ops": [
        {
         "op": "createObject",
         "args": {
          "type": "FOLDER",
          "name": "G"
         },
         "as": "g"
        },
        {
         "op": "createObject",
         "args": {
          "type": "BOX",
          "name": "B",
          "parent": "$g"
         },
         "as": "b"
        },
        {
         "op": "rename",
         "args": {
          "ref": "$b",
          "name": "B2"
         }
        },
        {
         "op": "getObject",
         "args": {
          "ref": {
           "id": "$b.id"
          }
         }
        },
        {
         "op": "getObject",
         "args": {
          "ref": "$g"
         }
        }
       ]
      }
     ],
     "expect": {
      "responses": {
       "b": {
        "ok": true,
        "protocol": 1,
        "results": [
         {
          "op": "createObject",
          "ok": true,
          "result": {
           "path": "/G"
          }
         },
         {
          "op": "createObject",
          "ok": true,
          "result": {
           "path": "/G/B"
          }
         },
         {
          "op": "rename",
          "ok": true,
          "result": {
           "name": "B2",
           "path": "/G/B2"
          }
         },
         {
          "op": "getObject",
          "ok": true,
          "result": {
           "name": "B2"
          }
         },
         {
          "op": "getObject",
          "ok": true,
          "result": {
           "name": "G",
           "childCount": 1
          }
         }
        ]
       }
      }
     }
    }
   ]
  },
