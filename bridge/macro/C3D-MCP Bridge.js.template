// c3d-mcp bridge loader {{VERSION}} (generated by c3d-mcp install; edit the template, not this file)
function main(doc) {
  var geval = eval;
  var runtimePath = '{{RUNTIME_PATH}}';
  var mcpDir = '{{MCP_DIR}}';

  // Mirrors runtime util.asciiEscape: File.write truncates non-ASCII text (P05).
  function ascii(text) {
    return text.replace(/[\u007f-\uffff]/g, function (c) {
      return '\\u' + ('0000' + c.charCodeAt(0).toString(16)).slice(-4);
    });
  }

  try {
    var f = new File(runtimePath);
    f.open(READ_MODE);
    if (!f.isOpen()) { throw new Error('runtime not found: ' + runtimePath); }
    var src = f.read(f.size());
    f.close();
    geval(src);
    C3D.run(doc, mcpDir + '/');
  } catch (e) {
    try {
      var out = new File(mcpDir + '/outbox/_bootstrap-error.json');
      out.open(WRITE_MODE);
      out.write(ascii(JSON.stringify({
        message: String(e && e.message !== undefined ? e.message : e),
        line: e ? e.line : undefined,
        stack: e && e.stack ? String(e.stack).substring(0, 2000) : undefined,
        macroVersion: '{{VERSION}}',
        runtimePath: runtimePath,
        at: Date.now()
      })));
      out.close();
    } catch (e2) {
      print('c3d-mcp bootstrap failed: ' + e2);
    }
  }
}
