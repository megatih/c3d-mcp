{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://c3dmcp.dev/contracts/request.schema.json",
 "title": "Bridge request (inbox/<seq>-<uuid>.json)",
 "type": "object",
 "required": ["protocol", "id", "seq", "secret", "deadlineAt", "ops"],
 "additionalProperties": false,
 "properties": {
  "protocol": { "const": 1 },
  "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
  "seq": { "type": "string", "pattern": "^\\d{16}$" },
  "secret": { "type": "string", "minLength": 16, "maxLength": 128 },
  "expectDocument": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "fileName": { "type": "string" },
    "marker": { "type": "string", "pattern": "^__c3d_mcp_session_[0-9a-f-]{36}$" }
   }
  },
  "deadlineAt": { "type": "integer", "minimum": 0, "description": "absolute epoch milliseconds" },
  "ops": {
   "type": "array",
   "minItems": 1,
   "maxItems": 200,
   "items": {
    "type": "object",
    "required": ["op"],
    "additionalProperties": false,
    "properties": {
     "op": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
     "args": { "type": "object" },
     "as": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
    }
   }
  }
 }
}
