{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://c3dmcp.dev/contracts/helper-ipc.schema.json",
 "title": "Helper IPC (JSON lines over Unix socket MCP/helper.sock)",
 "$defs": {
  "request": {
   "type": "object",
   "required": ["id", "cmd"],
   "additionalProperties": false,
   "properties": {
    "id": { "type": "string" },
    "cmd": { "enum": ["ping", "status", "pressBridge", "pressMenu", "listMenus", "modalState", "windows", "raiseWindow", "captureWindow", "analyzeImage", "downscaleImage", "permissions", "launchApp", "newDocument", "dismissOwnModal"] },
    "args": { "type": "object" }
   }
  },
  "response": {
   "type": "object",
   "required": ["id", "ok"],
   "additionalProperties": false,
   "properties": {
    "id": { "type": "string" },
    "ok": { "type": "boolean" },
    "result": {},
    "error": {
     "type": "object",
     "required": ["code", "message"],
     "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "hint": { "type": "string" }, "details": {} }
    }
   }
  }
 }
}
