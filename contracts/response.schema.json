{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://c3dmcp.dev/contracts/response.schema.json",
 "title": "Bridge response (outbox/<id>.json)",
 "type": "object",
 "required": ["protocol", "id", "ok", "runtimeVersion", "results", "log", "startedAt", "finishedAt"],
 "additionalProperties": false,
 "properties": {
  "protocol": { "const": 1 },
  "id": { "type": "string" },
  "ok": { "type": "boolean" },
  "runtimeVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
  "error": { "$ref": "#/$defs/error" },
  "results": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["op", "ok"],
    "additionalProperties": false,
    "properties": {
     "op": { "type": "string" },
     "ok": { "type": "boolean" },
     "result": {},
     "error": { "$ref": "#/$defs/error" }
    }
   }
  },
  "log": { "type": "array", "items": { "type": "string" } },
  "startedAt": { "type": "integer" },
  "finishedAt": { "type": "integer" }
 },
 "$defs": {
  "error": {
   "type": "object",
   "required": ["code", "message"],
   "additionalProperties": false,
   "properties": {
    "code": { "type": "string" },
    "message": { "type": "string" },
    "hint": { "type": "string" },
    "details": {}
   }
  }
 }
}
