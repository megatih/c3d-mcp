{
  "name": "c3d-mcp",
  "version": "0.1.0",
  "description": "MCP server for Cheetah3D 8.1.3 on macOS",
  "type": "module",
  "license": "MIT",
  "bin": {
    "c3d-mcp": "bin/c3d-mcp.js"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "files": [
    "dist",
    "bin",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:live": "C3D_LIVE=1 vitest run --no-file-parallelism --config vitest.live.config.ts",
    "coverage": "vitest run --coverage",
    "sync-assets": "node scripts/sync-assets.mjs",
    "prepack": "node scripts/sync-assets.mjs && npm run build",
    "pretest": "node ../../scripts/build-runtime.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "smol-toml": "1.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "mcpName": "io.github.megatih/c3d-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/megatih/c3d-mcp.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/megatih/c3d-mcp#readme",
  "bugs": {
    "url": "https://github.com/megatih/c3d-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cheetah3d",
    "3d",
    "macos"
  ]
}
